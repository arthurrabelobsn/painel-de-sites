# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Google Cloud → APIs & Services → Credentials (ative a "Places API (New)")
GOOGLE_PLACES_API_KEY=AIza...

# Opcional: chave padrão do Gemini (cada usuário também pode cadastrar a própria em Configurações)
GEMINI_API_KEY=
# Opcional: forçar um modelo do Gemini (vazio = gemini-3.8-flash, com troca automática se for aposentado)
GEMINI_MODEL=

# Buscas novas por usuário por dia (padrão 3)
DAILY_SEARCH_LIMIT=3
# E-mails sem limite de busca (ex.: o seu), separados por vírgula
SEARCH_LIMIT_EXEMPT_EMAILS=

# Hubla: cada compra aprovada cria o acesso do comprador (rota /api/hubla)
HUBLA_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
DEFAULT_USER_PASSWORD=
# opcional: só libera acesso para estes produtos (ids separados por vírgula)
HUBLA_PRODUCT_IDS=

# E-mail de boas-vindas (Resend) — opcional
RESEND_API_KEY=
EMAIL_FROM="Painel de Sites <acesso@seudominio.com>"
APP_URL=https://painel-de-sites.vercel.app
APP_NAME="Painel de Sites"
# link "Ainda não tem acesso?" na tela de login (página de vendas) — opcional
NEXT_PUBLIC_SALES_URL=
